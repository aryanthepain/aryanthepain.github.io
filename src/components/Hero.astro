---
---

<section id="hero" class="hero-section">
  <div class="site-container hero-container">
    
    <!-- Top Status & Terminal Prompt Indicator -->
    <div class="hero-meta">
      <div class="status-pill">
        <span class="status-dot"></span>
        <span>FINAL YEAR @ IIT GUWAHATI &bull; OPEN TO ROLES</span>
      </div>
      <div class="system-prompt font-mono">
        <span class="prompt-user">guest@aryan-portfolio</span>:<span class="prompt-path">~</span>$ <span class="prompt-cmd">whoami</span>
      </div>
    </div>

    <!-- Main Title & Headline -->
    <div class="hero-content">
      <h1 class="hero-name font-mono">
        Aryan <span class="text-gradient-green">Gupta</span>
      </h1>
      <p class="hero-tagline font-mono">
        Data Science & AI Engineer <span class="divider">/</span> Minor in Product Design
      </p>
      <p class="hero-bio">
        Engineering intelligent systems from mathematical foundations to production interfaces. Specializing in 
        <strong class="highlight">Deep Learning & Audio Processing</strong>, 
        <strong class="highlight">Quantitative Trading Models</strong>, 
        <strong class="highlight">LLM/RAG Infrastructure</strong>, and 
        <strong class="highlight">Autonomous AI Workflows</strong>.
      </p>
    </div>

    <!-- Key Metrics Grid -->
    <div class="hero-stats-grid">
      <div class="stat-card">
        <div class="stat-number font-mono">IIT Guwahati</div>
        <div class="stat-label">B.Tech in Data Science & AI</div>
      </div>
      <div class="stat-card">
        <div class="stat-number font-mono">Microsoft</div>
        <div class="stat-label">Software Engineering Intern</div>
      </div>
      <div class="stat-card">
        <div class="stat-number font-mono">AIR 1001</div>
        <div class="stat-label">JEE Advanced Rank</div>
      </div>
      <div class="stat-card">
        <div class="stat-number font-mono">12+ Projects</div>
        <div class="stat-label">ML, Quant, Systems & Web</div>
      </div>
    </div>

    <!-- Hero Actions & Socials -->
    <div class="hero-actions">
      <a href="#projects" class="btn btn-primary">
        <span>Explore Flagship Projects</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </a>

      <a href="#resume" class="btn btn-secondary">
        <span>View & Download Resumes</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="12" y1="18" x2="12" y2="12"></line>
          <line x1="9" y1="15" x2="12" y2="18"></line>
          <line x1="15" y1="15" x2="12" y2="18"></line>
        </svg>
      </a>

      <div class="social-links">
        <a href="https://github.com/aryanthepain" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub Profile">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
          </svg>
          <span class="social-text">GitHub</span>
        </a>

        <a href="https://huggingface.co/spaces/aryanthepain/Noise_Suppression_Model" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="Hugging Face Spaces">
          <span class="hf-emoji">&#129303;</span>
          <span class="social-text">Hugging Face</span>
        </a>

        <a href="https://www.linkedin.com/in/aryanthepain/" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn Profile">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect x="2" y="9" width="4" height="12"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
          <span class="social-text">LinkedIn</span>
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-section {
    padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4.5rem);
    position: relative;
  }

  .hero-container {
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .system-prompt {
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: var(--bg-surface);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .prompt-user { color: var(--term-cyan); }
  .prompt-path { color: var(--term-amber); }
  .prompt-cmd { color: var(--term-green); }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    max-width: 860px;
  }

  .hero-name {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .hero-tagline {
    font-size: clamp(1.125rem, 2.2vw, 1.5rem);
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: -0.02em;
  }

  .hero-tagline .divider {
    color: var(--term-green);
    margin-inline: 0.35rem;
  }

  .hero-bio {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--text-secondary);
    line-height: 1.7;
    margin-top: 0.5rem;
    text-wrap: pretty;
  }

  .hero-bio .highlight {
    color: var(--text-primary);
    font-weight: 600;
  }

  /* Stats Grid */
  .hero-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.4rem;
    box-shadow: var(--shadow-card);
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .stat-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-medium);
  }

  .stat-number {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--term-green);
    margin-bottom: 0.25rem;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  /* Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.7rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .social-btn:hover {
    border-color: var(--term-green);
    color: var(--term-green);
    transform: translateY(-2px);
  }

  .hf-emoji {
    font-size: 1rem;
    line-height: 1;
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn {
      width: 100%;
    }
    .social-links {
      width: 100%;
      justify-content: space-between;
    }
    .social-btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>
