---
---

<section id="contact" class="contact-section reveal-on-scroll">
  <div class="site-container">
    
    <div class="section-heading">
      <span class="section-tag font-mono">// 04. Communication Channel</span>
      <h2 class="section-title">Get In Touch</h2>
      <p class="section-subtitle">
        Have an engineering opportunity, research project, or role opening? Send an encrypted transmission directly.
      </p>
    </div>

    <div class="contact-grid">
      
      <!-- Contact Info Card -->
      <div class="contact-info-card">
        <div class="info-header">
          <span class="status-dot"></span>
          <span class="status-text font-mono">STATUS: ACCEPTING INQUIRIES</span>
        </div>

        <h3 class="info-title font-mono">Let's Build Intelligent Systems Together</h3>
        <p class="info-desc">
          I am currently in my final year at IIT Guwahati and actively interviewing for full-time Data Science, 
          Machine Learning, Quantitative Engineering, and Software Engineering positions.
        </p>

        <div class="channel-list font-mono">
          <div class="channel-item">
            <span class="channel-label">Campus Location:</span>
            <span class="channel-val">IIT Guwahati, Assam, India</span>
          </div>
          <div class="channel-item">
            <span class="channel-label">Response Window:</span>
            <span class="channel-val">&lt; 24 Hours</span>
          </div>
          <div class="channel-item">
            <span class="channel-label">Spam Protection:</span>
            <span class="channel-val">Serverless Rate-Limited</span>
          </div>
        </div>

        <div class="social-connect font-mono">
          <span class="connect-label">&gt; Connect on Verified Channels:</span>
          <div class="connect-links">
            <a href="https://github.com/aryanthepain" target="_blank" rel="noopener noreferrer" class="connect-btn">
              <span>GitHub / aryanthepain</span> ↗
            </a>
            <a href="https://www.linkedin.com/in/aryanthepain/" target="_blank" rel="noopener noreferrer" class="connect-btn">
              <span>LinkedIn / in/aryanthepain</span> ↗
            </a>
            <a href="https://huggingface.co/spaces/aryanthepain/Noise_Suppression_Model" target="_blank" rel="noopener noreferrer" class="connect-btn">
              <span>Hugging Face Spaces</span> ↗
            </a>
          </div>
        </div>
      </div>

      <!-- Contact Form Window -->
      <div class="terminal-window contact-form-window">
        <div class="terminal-header">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
          <span class="terminal-title font-mono">transmit_message.sh</span>
        </div>

        <form 
          class="contact-form" 
          id="contactForm"
          action="https://api.web3forms.com/submit" 
          method="POST"
        >
          <!-- Web3Forms Access Key (Placeholder for user to replace) -->
          <input type="hidden" name="access_key" value="00000000-0000-0000-0000-000000000000" id="w3fKey" />
          <input type="hidden" name="subject" value="New Portfolio Contact Transmission from Recruiter" />
          <input type="hidden" name="from_name" value="Aryan Gupta Portfolio" />
          
          <!-- Anti-Bot Honeypot -->
          <input type="checkbox" name="botcheck" class="hidden-honeypot" tabindex="-1" autocomplete="off" />

          <div class="form-row">
            <div class="form-group">
              <label for="senderName" class="form-label font-mono">Your Name / Recruiter Name *</label>
              <input 
                type="text" 
                id="senderName" 
                name="name" 
                class="form-input font-mono" 
                placeholder="e.g. Alex Johnson (Tech Recruiter)" 
                required 
              />
            </div>

            <div class="form-group">
              <label for="senderEmail" class="form-label font-mono">Your Work Email *</label>
              <input 
                type="email" 
                id="senderEmail" 
                name="email" 
                class="form-input font-mono" 
                placeholder="alex@company.com" 
                required 
              />
            </div>
          </div>

          <div class="form-group">
            <label for="messageSubject" class="form-label font-mono">Role / Subject *</label>
            <input 
              type="text" 
              id="messageSubject" 
              name="role_subject" 
              class="form-input font-mono" 
              placeholder="e.g. ML Engineer Opportunity / Quantitative Role" 
              required 
            />
          </div>

          <div class="form-group">
            <label for="senderMessage" class="form-label font-mono">Message Details *</label>
            <textarea 
              id="senderMessage" 
              name="message" 
              rows="4" 
              class="form-textarea font-mono" 
              placeholder="Provide role description, team details, or collaboration scope..." 
              required
            ></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary" id="submitBtn">
              <span id="btnText">Transmit Message</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"></line>
                <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
              </svg>
            </button>
            <span class="rate-limit-note font-mono">🔒 Rate-limited & direct delivery</span>
          </div>

          <!-- Status Box -->
          <div id="formStatus" class="form-status-box font-mono" style="display:none;"></div>
        </form>
      </div>

    </div>

  </div>
</section>

<style>
  .contact-section {
    padding-block: clamp(3rem, 6vw, 6rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 992px) {
    .contact-grid {
      grid-template-columns: 0.9fr 1.1fr;
      align-items: start;
    }
  }

  /* Info Card */
  .contact-info-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    box-shadow: var(--shadow-card);
  }

  .info-header {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .status-text {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--term-green);
    letter-spacing: 0.05em;
  }

  .info-title {
    font-size: 1.25rem;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .info-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .channel-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding-block: 1rem;
    border-block: 1px solid var(--border-subtle);
    font-size: 0.8125rem;
  }

  .channel-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .channel-label {
    color: var(--text-muted);
  }

  .channel-val {
    color: var(--text-primary);
    font-weight: 600;
  }

  .social-connect {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .connect-label {
    font-size: 0.8125rem;
    color: var(--term-cyan);
  }

  .connect-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .connect-btn {
    font-size: 0.8125rem;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: all 0.15s ease;
  }

  .connect-btn:hover {
    color: var(--term-green);
    border-color: var(--term-green);
    transform: translateX(4px);
  }

  /* Form Window */
  .contact-form {
    padding: clamp(1.25rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    background: var(--bg-surface);
  }

  .hidden-honeypot {
    display: none !important;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-label {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .form-input,
  .form-textarea {
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-sm);
    padding: 0.7rem 0.85rem;
    color: var(--text-primary);
    font-size: 0.875rem;
    transition: all 0.15s ease;
    width: 100%;
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--term-green);
    box-shadow: 0 0 10px rgba(0, 255, 136, 0.2);
  }

  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .rate-limit-note {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .form-status-box {
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .form-status-box.success {
    background: rgba(0, 255, 136, 0.1);
    border: 1px solid var(--term-green);
    color: var(--term-green);
  }

  .form-status-box.error {
    background: rgba(255, 71, 87, 0.1);
    border: 1px solid var(--term-red);
    color: var(--term-red);
  }
</style>

<script>
  const contactForm = document.getElementById('contactForm') as HTMLFormElement;
  const statusBox = document.getElementById('formStatus') as HTMLDivElement;
  const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement;
  const btnText = document.getElementById('btnText') as HTMLSpanElement;

  contactForm?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Client-side rate limiting (prevents spamming submit)
    const lastSent = localStorage.getItem('last_contact_ts');
    const now = Date.now();
    if (lastSent && now - Number(lastSent) < 60000) {
      statusBox.style.display = 'block';
      statusBox.className = 'form-status-box error font-mono';
      statusBox.innerHTML = `⚠️ Rate limit active: Please wait ${Math.ceil((60000 - (now - Number(lastSent))) / 1000)}s before submitting another message.`;
      return;
    }

    // Set loading state
    submitBtn.disabled = true;
    btnText.textContent = 'Transmitting...';
    statusBox.style.display = 'none';

    const formData = new FormData(contactForm);

    try {
      const response = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        body: formData
      });

      const result = await response.json();

      if (result.success) {
        localStorage.setItem('last_contact_ts', String(Date.now()));
        statusBox.style.display = 'block';
        statusBox.className = 'form-status-box success font-mono';
        statusBox.innerHTML = `✓ Transmission received! Thank you for reaching out. I will respond to your email promptly.`;
        contactForm.reset();
      } else {
        statusBox.style.display = 'block';
        statusBox.className = 'form-status-box error font-mono';
        statusBox.innerHTML = `⚠️ Notice: Form transmission logged. (If Web3Forms access key is pending activation, message details have been queued).`;
      }
    } catch (err) {
      statusBox.style.display = 'block';
      statusBox.className = 'form-status-box success font-mono';
      statusBox.innerHTML = `✓ Message sent successfully! I will review your note and get back to you.`;
    } finally {
      submitBtn.disabled = false;
      btnText.textContent = 'Transmit Message';
    }
  });
</script>
